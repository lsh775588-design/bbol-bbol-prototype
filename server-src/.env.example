# 이 파일을 복사해서 .env로 만든 뒤 값 채우기
# 주석(#) 처리된 값은 application.yml의 로컬 기본값이 쓰임
# 빈 값(KEY=)으로 두면 기본값 대신 빈 문자열이 들어가서 에러가 나니, 안 쓰는 값은 주석으로 두기

# DB 계정
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=

# DB 접속 정보 (기본값: localhost:5432/bbolbbol)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bbolbbol

# Hibernate ddl-auto (기본값: validate. 스키마는 Flyway가 관리함)
# JPA_DDL_AUTO=validate

# Redis (기본값: localhost:6379)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Gmail SMTP
# MAIL_USERNAME=
# MAIL_PASSWORD=
