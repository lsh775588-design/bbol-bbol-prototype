# 값은 비워 두고, 실제 값은 .env(커밋 금지)에만 적는다. 이름은 application.yml / docker-compose.yml과 같다.

# --- docker-compose (MySQL, Redis) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bbolbbol
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=3307
REDIS_PORT=6380

# --- backend (application.yml) ---
MYSQL_URL=jdbc:mysql://localhost:3307/bbolbbol
REDIS_HOST=localhost
REDIS_PASSWORD=
JPA_DDL_AUTO=validate
JWT_SECRET=
JWT_EXPIRATION=3600000
MAIL_USERNAME=
MAIL_PASSWORD=
KAKAO_REST_API_KEY=
STORAGE_LOCAL_PATH=./uploads
